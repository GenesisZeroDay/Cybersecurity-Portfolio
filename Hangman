import java.util.Scanner;
import java.util.Random;

public class Hangman
{
    public static void main(String[] args)
    {
        Scanner scan = new Scanner(System.in);
        Random random = new Random();

        String[] words = {"JAVA", "COMPUTER", "NETWORK", "PROGRAM", "SCHOOL"};

        int randomIndex = random.nextInt(words.length);
        String secretWord = words[randomIndex];

        String guessedLetters = "";
        String hiddenWord = "";
        int incorrectGuesses = 0;
        int maxAttempts = 6;

        System.out.println("===== HANGMAN GAME =====");
        System.out.println("Guess the secret word one letter at a time!");
        System.out.printf("You have %d incorrect guesses allowed.%n", maxAttempts);

        while (incorrectGuesses < maxAttempts && !hiddenWord.equals(secretWord))
        {
            hiddenWord = "";

            for (int i = 0; i < secretWord.length(); i++)
            {
                String letter = secretWord.substring(i, i + 1);

                if (guessedLetters.indexOf(secretWord.charAt(i)) >= 0)
                {
                    hiddenWord = hiddenWord + letter;
                }
                else
                {
                    hiddenWord = hiddenWord + "_";
                }

                hiddenWord = hiddenWord + " ";
            }

            System.out.println("\nWord: " + hiddenWord);
            System.out.println("Guessed letters: " + guessedLetters);
            System.out.printf("Incorrect guesses: %d%n", incorrectGuesses);

            int remainingAttempts = Math.max(0, maxAttempts - incorrectGuesses);
            System.out.printf("Remaining attempts: %d%n", remainingAttempts);

            System.out.print("Enter a letter: ");
            String input = scan.next().toUpperCase();

            if (input.length() != 1 || !Character.isLetter(input.charAt(0)))
            {
                System.out.println("Please enter one letter.");
            }
            else
            {
                char guess = input.charAt(0);

                if (guessedLetters.indexOf(guess) >= 0)
                {
                    System.out.println("You already guessed that letter.");
                }
                else
                {
                    guessedLetters = guessedLetters + guess;

                    if (secretWord.indexOf(guess) >= 0)
                    {
                        System.out.println("Correct guess!");
                    }
                    else
                    {
                        System.out.println("Incorrect guess!");
                        incorrectGuesses++;
                    }
                }
            }

            hiddenWord = "";

            for (int i = 0; i < secretWord.length(); i++)
            {
                if (guessedLetters.indexOf(secretWord.charAt(i)) >= 0)
                {
                    hiddenWord = hiddenWord + secretWord.charAt(i);
                }
                else
                {
                    hiddenWord = hiddenWord + "_";
                }
            }
        }

        System.out.println();

        if (hiddenWord.equals(secretWord))
        {
            System.out.println("Congratulations! You guessed the word!");
        }
        else
        {
            System.out.println("Game over! You ran out of attempts.");
        }

        System.out.println("The secret word was: " + secretWord);
        System.out.println("===== END OF GAME =====");

        scan.close();
    }
}
